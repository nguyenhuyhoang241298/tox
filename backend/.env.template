# Environment Configuration
NODE_ENV="development" # Options: 'development', 'production'
PORT="8080"            # The port your server will listen on
HOST="localhost"       # Hostname for the server

# CORS Settings
CORS_ORIGIN="http://localhost:5173" # Địa chỉ của web (Vite dev server mặc định chạy ở cổng 5173)

# Số reverse proxy đứng trước backend (0 khi chạy local, thường là 1 khi deploy sau load balancer)
TRUST_PROXY="0"

# Rate Limiting
COMMON_RATE_LIMIT_WINDOW_MS="60000"  # Window size for rate limiting (ms)
COMMON_RATE_LIMIT_MAX_REQUESTS="300" # Max number of requests per window per IP
